# Sample contents for infra/.env.example

# This is an example environment variable configuration file.
# Copy this file to .env and fill in the required values.

# Database configuration
DATABASE_URL=postgresql://username:password@localhost:5432/pet_choice_india

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Payment gateway configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret

PAYU_MERCHANT_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_salt

# Other configurations
DEBUG=True
CORS_ORIGINS=http://localhost:3000

# Email configuration
SMTP_SERVER=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# Add any other environment variables as needed.

# Figma integration (frontend tooling)
FIGMA_FILE_ID=your_figma_file_id_here
FIGMA_TOKEN=your_figma_personal_access_token_here